# Copy to .env and fill in. .env is gitignored; never commit real keys.

# CollegeFootballData API key (free tier ~1,000 calls/month):
# https://collegefootballdata.com/key
CFBD_API_KEY=

# Where downloaded data is cached. Defaults to ./data if unset.
# AI_NFL_GM_DATA_DIR=./data

# Logging level for scripts and the API (DEBUG, INFO, WARNING, ERROR).
# AI_NFL_GM_LOG_LEVEL=INFO
